@page
@model Belkhidmah.Web.Pages.ForgotModel
@{
    ViewData["Title"] = Model.T("forgotTitle");
    ViewData["Page"] = "forgot";
    var otherLang = Model.IsAr ? "en" : "ar";
}

<div class="relative min-h-screen overflow-hidden">
    <div class="absolute inset-0 bg-linear-to-b from-overlay-ink via-overlay-mid to-overlay-ink" aria-hidden="true"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(75,109,148,0.22)_0%,transparent_70%)]" aria-hidden="true"></div>

    <div class="relative z-10 mx-auto flex min-h-screen max-w-lg flex-col justify-center px-4 py-16">
        <div class="mb-4 flex justify-end">
            <a href="?lang=@otherLang" class="rounded-lg px-3 py-1.5 text-sm font-medium text-white/80 hover:bg-white/10 hover:text-white">
                @Model.T("lang")
            </a>
        </div>

        <section data-enter-panel class="glass-card-dark rounded-2xl p-8 text-center">
            <img src="~/images/logo.svg" alt="" width="56" height="56" class="mx-auto mb-5" />
            <h1 class="mb-3 text-3xl font-extrabold text-white">@Model.T("forgotTitle")</h1>
            <p class="mb-8 text-white/75">@Model.T("forgotBody")</p>
            <a asp-page="/Index" class="btn-brand">@Model.T("backToSignIn")</a>
        </section>
    </div>
</div>
