@page
@model Belkhidmah.Web.Pages.IndexModel
@{
    ViewData["Title"] = Model.T("signIn");
    ViewData["Page"] = "login";
    var otherLang = Model.IsAr ? "en" : "ar";
}

<div class="relative min-h-screen overflow-hidden selection:bg-brand-pink selection:text-white">
    <div class="absolute inset-0" aria-hidden="true">
        <img
            src="https://images.unsplash.com/photo-1555041469-a586c61ea9bc?auto=format&fit=crop&w=2400&q=80"
            alt=""
            class="h-full w-full object-cover" />
        <div class="absolute inset-0 bg-linear-to-b from-overlay-ink/90 via-overlay-mid/78 to-overlay-ink/94"></div>
        <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(75,109,148,0.28)_0%,transparent_70%)]"></div>
    </div>

    <div class="relative z-10 mx-auto grid min-h-screen w-full max-w-7xl items-center gap-10 px-4 py-16 sm:px-6 lg:grid-cols-2 lg:gap-16 lg:px-8 lg:py-20">
        <section data-enter-visual class="order-2 text-center lg:order-1 lg:text-start">
            <img
                src="~/images/logo.svg"
                alt=""
                width="72"
                height="72"
                class="mx-auto mb-6 drop-shadow-[0_6px_18px_rgba(0,0,0,0.75)] lg:mx-0" />
            <p class="mb-3 text-sm font-semibold tracking-[0.2em] text-brand-blush uppercase">@Model.T("visualKicker")</p>
            <h1 class="mb-4 max-w-xl text-balance text-3xl font-extrabold leading-[1.15] tracking-tight text-white sm:text-5xl lg:text-6xl">
                @Model.T("visualTitle")
            </h1>
            <p class="mx-auto max-w-xl text-base font-normal leading-relaxed text-white/90 sm:text-xl lg:mx-0">
                @Model.T("visualBody")
            </p>
        </section>

        <div data-enter-panel class="order-1 lg:order-2">
            <div class="mb-4 flex justify-end">
                <a
                    href="?lang=@otherLang"
                    class="rounded-lg px-3 py-1.5 text-sm font-medium text-white/80 transition hover:bg-white/10 hover:text-white">
                    @Model.T("lang")
                </a>
            </div>
            <partial name="_LoginPanel" model="Model" />
        </div>
    </div>
</div>
